{
  "openapi": "3.0.3",
  "info": {
    "title": "notifications",
    "version": "1.0.2",
    "description": "Persistent, realtime in-app notifications. All data endpoints require a Bearer HS512 JWT (estate-shared JWT_SECRET). The WebSocket endpoint authenticates via ?token= query param instead."
  },
  "servers": [
    { "url": "http://localhost:8090" }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness probe (alias of /api/notifications/health)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/notifications/health": {
      "get": {
        "operationId": "healthApi",
        "summary": "Liveness probe (alias of /health)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "List the authenticated user's notifications, newest first",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 50, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "List of notifications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Notification" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/StorageError" }
        }
      }
    },
    "/api/notifications/unread-count": {
      "get": {
        "operationId": "unreadCount",
        "summary": "Count of the authenticated user's unread notifications",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Unread count",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UnreadCountResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/StorageError" }
        }
      }
    },
    "/api/notifications/read-all": {
      "post": {
        "operationId": "markAllRead",
        "summary": "Mark all of the user's notifications as read; pushes a live unread event",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Ok",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean", "enum": [true] } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/StorageError" }
        }
      }
    },
    "/api/notifications/{id}/read": {
      "post": {
        "operationId": "markOneRead",
        "summary": "Mark one notification read (matched on id + userId); pushes a live unread event",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "The notification id (24-hex random), not the Mongo _id"
          }
        ],
        "responses": {
          "200": {
            "description": "Ok (returned even if no document matched)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "ok": { "type": "boolean", "enum": [true] } }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/StorageError" }
        }
      }
    },
    "/api/notifications/ingest": {
      "post": {
        "operationId": "ingest",
        "summary": "Producer-facing bulk create for explicit recipient_ids (no role check)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/IngestRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ingest result",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/IngestResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/StorageError" }
        }
      }
    },
    "/api/notifications/ws": {
      "get": {
        "operationId": "wsStream",
        "summary": "Per-user WebSocket stream; token in query string",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "HS512 JWT; the stream is for claims.sub"
          }
        ],
        "responses": {
          "101": {
            "description": "WebSocket upgrade. First frame: {\"type\":\"init\",\"unread_count\":N,\"notifications\":[...last 50...]}. Then live {\"type\":\"unread\",...} and {\"type\":\"notification\",...} frames; Ping every 30s."
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "HS512 JWT"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": { "error": { "type": "string" } }
            }
          }
        }
      },
      "StorageError": {
        "description": "Mongo storage failure",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": { "error": { "type": "string" } }
            }
          }
        }
      }
    },
    "schemas": {
      "Notification": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "description": "Mongo ObjectId (omitted on fresh inserts)" },
          "id": { "type": "string", "description": "24-hex random notification id" },
          "userId": { "type": "string" },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "link": { "type": "string" },
          "referenceId": { "type": "string" },
          "read": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "userId", "kind", "title", "body", "read", "createdAt"]
      },
      "IngestRequest": {
        "type": "object",
        "properties": {
          "recipient_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "kind": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "link": { "type": "string" },
          "reference_id": { "type": "string" }
        },
        "required": ["recipient_ids", "kind", "title", "body"]
      },
      "IngestResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "notified": { "type": "integer", "description": "Deduped recipient rows created" }
        }
      },
      "UnreadCountResponse": {
        "type": "object",
        "properties": { "unread_count": { "type": "integer" } }
      },
      "HealthResponse": {
        "type": "object",
        "properties": { "status": { "type": "string", "enum": ["OK"] } }
      }
    }
  }
}
